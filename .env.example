# Kepware ThingsBoard 點位管理系統 - 環境變數設定
# 複製此檔案為 .env 並填入實際值

# ThingsBoard 預設連線資訊 (可在網頁上覆蓋)
TB_URL=http://10.11.64.64:8082
TB_USERNAME=tenant@thingsboard.org
TB_PASSWORD=

# ThingsBoard SSL 設定（僅 HTTPS 時需要）
# 若使用自簽憑證，設定 TB_VERIFY_SSL=false 停用驗證
# 若有企業 CA 憑證，設定 TB_CA_BUNDLE 指定 PEM 檔路徑（優先於 TB_VERIFY_SSL）
TB_VERIFY_SSL=true
#TB_CA_BUNDLE=C:/path/to/company-ca.pem

# TB Proxy 設定：預設 false（繞過企業 Proxy 直連內網 TB）
# 若 TB 在外網且需透過公司 Proxy 才能連到，改為 true
TB_USE_PROXY=false

# PostgreSQL 連線設定
PG_HOST=10.11.64.11
PG_PORT=5432
PG_DATABASE=your_db_name
PG_USER=your_username
PG_PASSWORD=your_password

# Kepware API Gateway 連線設定 (可在網頁上覆蓋)
KW_GW_URL=http://localhost:8000
KW_GW_USERNAME=admin
KW_GW_PASSWORD=

# Kepware Gateway SSL 設定（僅 HTTPS 時需要）
KW_GW_VERIFY_SSL=true
#KW_GW_CA_BUNDLE=C:/path/to/kepware-ca.pem

# Kepware Gateway Proxy 設定：預設 false（繞過企業 Proxy）
KW_GW_USE_PROXY=false

# Web 伺服器設定
WEB_HOST=0.0.0.0
WEB_PORT=9000
