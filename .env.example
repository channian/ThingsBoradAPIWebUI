# Kep It Simple · Kepware 點位管理系統 - 環境變數設定
# 複製此檔案為 .env 並填入實際值

# PostgreSQL 連線設定
PG_HOST=10.11.64.11
PG_PORT=5432
PG_DATABASE=your_db_name
PG_USER=your_username
PG_PASSWORD=your_password

# Kepware Gateway 密碼加密金鑰（必改！用於加密儲存在 DB 中的 Gateway 密碼）
KW_ENCRYPT_KEY=change-this-to-a-random-string

# Kepware Gateway SSL 設定（全域預設，個別 Gateway 可在 DB 中覆蓋）
KW_GW_VERIFY_SSL=true
#KW_GW_CA_BUNDLE=C:/path/to/kepware-ca.pem

# Kepware Gateway Proxy 設定：預設 false（繞過企業 Proxy）
KW_GW_USE_PROXY=false

# Collector DB 連線設定（與 PG 同主機，僅 database 不同）
COLLECTOR_DB_DATABASE=collector_db

# Collector Reload API 設定
COLLECTOR_RELOAD_URL=http://localhost:8080/reload
COLLECTOR_RELOAD_TOKEN=your-reload-token

# 使用者認證設定
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
JWT_SECRET_KEY=kepitsimple-change-this-to-random-string
JWT_EXPIRE_HOURS=24

# CSV 上傳限制與暫存檔清理（皆為選填，未設定則套用預設值）
# 單檔上傳大小上限（bytes），預設 10485760（10MB）
CSV_UPLOAD_MAX_BYTES=10485760
# 單檔資料筆數上限，預設 50000
CSV_UPLOAD_MAX_ROWS=50000
# 暫存 CSV 上傳檔保留天數，超過即於每週一凌晨 3 點清理排程中刪除，預設 30
CSV_UPLOAD_CLEANUP_DAYS=30

# 安全鎖：限制單次批次作業的點數與單一 Gateway 的任務佇列深度（皆為選填，未設定則套用預設值）
# 超過上限時，系統會拒絕該次請求並提示改為分批處理；
# 設定值必須是大於 0 的整數，非整數或 <= 0 的值會被忽略（退回預設值）並在日誌中記錄警告。
# Step 3 Kepware 建點：單次最多處理點數，預設 10000
KIS_LIMIT_KW_EXECUTE=10000
# Step 5 Kepware Scale 設定：單次最多處理點數，預設 10000
KIS_LIMIT_SCALE=10000
# Kepware 批次刪除：單次最多處理點數，預設 2000（刪除不可逆，預設較保守）
KIS_LIMIT_DELETE=2000
# 單一 Gateway 同時允許的「排隊中＋執行中」任務數，預設 5
KIS_LIMIT_QUEUE_PER_GATEWAY=5

# Web 伺服器設定
WEB_HOST=0.0.0.0
WEB_PORT=9000
